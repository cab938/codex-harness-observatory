# Local harness-observatory launcher settings. This file is sourced by run.sh.
# Existing exported values win, so any setting can be overridden for one run.

OBSERVATORY_CODEX_BIN="${OBSERVATORY_CODEX_BIN:-codex-rs/target/debug/codex}"
OBSERVATORY_VIEWER_SCRIPT="${OBSERVATORY_VIEWER_SCRIPT:-tools/trace_viewer.py}"
OBSERVATORY_PYTHON="${OBSERVATORY_PYTHON:-python3}"

OBSERVATORY_APP_SERVER_HOST="${OBSERVATORY_APP_SERVER_HOST:-127.0.0.1}"
OBSERVATORY_APP_SERVER_PORT="${OBSERVATORY_APP_SERVER_PORT:-4500}"
OBSERVATORY_VIEWER_HOST="${OBSERVATORY_VIEWER_HOST:-127.0.0.1}"
OBSERVATORY_VIEWER_PORT="${OBSERVATORY_VIEWER_PORT:-8765}"

# This is a private teaching build: send complete event fields to the viewer and
# allow its evidence links to open the raw bundle payloads.
OBSERVATORY_SHOW_CONTENT="${OBSERVATORY_SHOW_CONTENT:-1}"

# Relative paths are resolved from this demonstration directory. Each launch
# receives its own retained run directory containing traces and service logs.
OBSERVATORY_WORKSPACE="${OBSERVATORY_WORKSPACE:-.}"
OBSERVATORY_RUNS_DIR="${OBSERVATORY_RUNS_DIR:-personal/observatory-runs}"
OBSERVATORY_STARTUP_TIMEOUT_SECONDS="${OBSERVATORY_STARTUP_TIMEOUT_SECONDS:-15}"

# This disables the separate OpenAI remote-control transport, not the loopback
# WebSocket endpoint used by this demonstration.
OBSERVATORY_DISABLE_REMOTE_CONTROL="${OBSERVATORY_DISABLE_REMOTE_CONTROL:-1}"

# Authentication is inherited from the normal Codex login/configuration. No API
# key needs to be copied into this file when `codex login` already works.
