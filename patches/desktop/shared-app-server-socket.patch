 }
 
+function patchExtractedApp(extractedDir) {
+  const buildDir = path.join(extractedDir, ".vite", "build");
+  const candidates = fs.readdirSync(buildDir).filter(name => name.endsWith(".js")).map(name => {
+    const bundlePath = path.join(buildDir, name);
+    return { bundlePath, source: fs.readFileSync(bundlePath, "utf8") };
+  }).filter(({ source }) => source.includes("AppServerTransportSshWebsocket") && source.includes("selected app-server transport"));
+  if (candidates.length !== 1) return { matched: 0, changed: 0, reason: "Expected one app-server transport bundle" };
+  const { bundlePath, source } = candidates[0];
+  const patched = applySharedAppServerSocketPatch(source);
+  if (!patched.includes("class CodexLinuxSharedAppServerSocketTransport")) return { matched: 0, changed: 0, reason: "Unsupported app-server transport factory" };
+  if (patched !== source) fs.writeFileSync(bundlePath, patched, "utf8");
+  return { matched: 1, changed: Number(patched !== source), targets: [path.relative(extractedDir, bundlePath)] };
+}
+
