+test("extracted bundle patch targets the unique transport and rejects ambiguity", () => {
+  const temp = fs.mkdtempSync(path.join(os.tmpdir(), "observatory-transport-"));
+  try {
+    const build = path.join(temp, ".vite", "build");
+    fs.mkdirSync(build, { recursive: true });
+    const file = path.join(build, "transport.js");
+    fs.writeFileSync(file, syntheticBundle());
+    assert.equal(patchExtractedApp(temp).changed, 1);
+    assert.equal(patchExtractedApp(temp).changed, 0);
+    fs.writeFileSync(path.join(build, "ambiguous.js"), syntheticBundle());
+    assert.equal(patchExtractedApp(temp).matched, 0);
+  } finally {
+    fs.rmSync(temp, { recursive: true, force: true });
